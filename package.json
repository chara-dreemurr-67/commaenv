{
  "name": "commaenv",
  "version": "3.0.0",
  "description": "An environment variable parser for nodejs. Unlike dotenv, this parses environment variables instead of loading them.",
  "keywords": [
    "env",
    "cross-platform",
    "environment",
    "variables",
    "environment variables"
  ],
  "license": "GPL-3.0-only",
  "author": "chara-dreemurr-67",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chara-dreemurr-67/commaenv.git"
  },
  "homepage": "https://github.com/chara-dreemurr-67/commaenv#readme",
  "type": "module",
  "main": "./public/main.js",
  "scripts": {
    "build": "tsc",
    "cleanbuild": "(if exist \"./public\" rmdir /s /q \"./public\") && tsc",
    "buildtest": "npm run cleanbuild && npm pack"
  },
  "files": [
    "public"
  ],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
